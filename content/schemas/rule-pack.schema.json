{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baselineguard.invalid/schemas/rule-pack-v1.schema.json",
  "title": "BaselineGuard declarative rule pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "version", "publisher", "license", "engine_compatibility", "benchmark", "targets", "parameters", "controls"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "pack_id": {"$ref": "#/$defs/key"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "publisher": {"type": "string", "minLength": 1, "maxLength": 255},
    "license": {"type": "string", "minLength": 1, "maxLength": 128},
    "rights_reference": {"type": "string", "maxLength": 2048},
    "engine_compatibility": {"type": "string", "maxLength": 128},
    "benchmark": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["publisher", "product", "version", "profile", "rights_reference"], "properties": {"publisher": {"type": "string"}, "product": {"type": "string"}, "version": {"type": "string"}, "profile": {"type": "string"}, "rights_reference": {"type": "string"}, "reviewer": {"type": "string"}, "reviewed_at": {"type": "string", "format": "date"}}}
      ]
    },
    "targets": {"type": "object", "additionalProperties": false, "required": ["family", "version_range", "roles"], "properties": {"family": {"$ref": "#/$defs/key"}, "version_range": {"type": "string", "maxLength": 128}, "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}}},
    "parameters": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"enum": ["integer", "number", "string", "boolean", "enum"]}, "minimum": {"type": "number"}, "maximum": {"type": "number"}, "values": {"type": "array", "maxItems": 100}, "default": {}}}},
    "controls": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/control"}},
    "change_log": {"type": "array", "items": {"type": "string", "maxLength": 1000}}
  },
  "$defs": {
    "key": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9_.:/-]+$"},
    "expression": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["op", "fact", "value"], "properties": {"op": {"enum": ["eq", "ne", "lt", "lte", "gt", "gte", "in", "contains"]}, "fact": {"$ref": "#/$defs/key"}, "value": {}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "args"], "properties": {"op": {"enum": ["and", "or"]}, "args": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/expression"}}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "arg"], "properties": {"op": {"const": "not"}, "arg": {"$ref": "#/$defs/expression"}}}
      ]
    },
    "fixture": {"type": "object", "additionalProperties": false, "required": ["id", "expect", "facts"], "properties": {"id": {"$ref": "#/$defs/key"}, "expect": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE", "UNKNOWN", "ERROR", "MANUAL_REQUIRED"]}, "facts": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"enum": ["PRESENT", "ABSENT_CONFIRMED", "UNAVAILABLE", "UNSUPPORTED", "CONFLICT"]}, "value": {}}}}}},
    "control": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "origin", "title", "severity", "applicability", "required_facts", "assertion", "expected", "evidence", "remediation_template", "tests"], "properties": {"id": {"$ref": "#/$defs/key"}, "revision": {"type": "integer", "minimum": 1}, "origin": {"enum": ["organizational", "cis_mapped", "vendor_guidance"]}, "source_mapping": {"type": "object", "additionalProperties": false, "required": ["benchmark", "version", "recommendation_id", "reviewer", "reviewed_at", "rights_reference"], "properties": {"benchmark": {"type": "string"}, "version": {"type": "string"}, "recommendation_id": {"type": "string"}, "reviewer": {"type": "string"}, "reviewed_at": {"type": "string", "format": "date"}, "rights_reference": {"type": "string"}}}, "title": {"type": "string", "minLength": 1, "maxLength": 255}, "severity": {"enum": ["critical", "high", "medium", "low"]}, "description": {"type": "string", "maxLength": 10000}, "rationale": {"type": "string", "maxLength": 10000}, "applicability": {"$ref": "#/$defs/expression"}, "required_facts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}, "assertion": {"$ref": "#/$defs/expression"}, "expected": {"type": "object"}, "evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/key"}}, "remediation_template": {"$ref": "#/$defs/key"}, "tests": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/fixture"}}}}
  }
}
