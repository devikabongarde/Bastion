# Copy to .env for local development. Never commit credentials or keys.
POSTGRES_SUPERUSER_PASSWORD=replace-with-a-unique-random-password
BG_MIGRATION_PASSWORD=replace-with-a-different-random-password
BG_APP_PASSWORD=replace-with-a-third-random-password
BG_ENVIRONMENT=development
BG_API_HOST=127.0.0.1
BG_API_PORT=8000
BG_DATABASE_URL=postgresql+psycopg://bg_api:replace-me@127.0.0.1:55432/baselineguard
BG_MIGRATION_DATABASE_URL=postgresql+psycopg://bg_migration:replace-me@127.0.0.1:55432/baselineguard
BG_SESSION_SECRET=replace-with-at-least-32-random-bytes
BG_LOG_LEVEL=INFO
BG_DOCS_ENABLED=true
BG_CORS_ORIGINS=[]
BG_EVIDENCE_ROOT=./data/evidence


# Demo convenience: password-only sign-in (skips MFA). Rejected when BG_ENVIRONMENT=production.
BG_DEMO_LOGIN=false

# Lab convenience: allow loopback targets like the bundled mock device. Rejected in production.
BG_LAB_TARGETS=false
# Pinned SSH host keys for live collection.
BG_KNOWN_HOSTS_FILE=./data/known_hosts
